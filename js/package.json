{
  "name": "iclforge-wasm-decoder",
  "version": "0.0.0-dev",
  "description": "Streaming AC-3/E-AC-3 (Dolby Digital/Digital Plus) decoder for the browser, compiled from iclforge::ac3 to WebAssembly - a push-frame API, an AudioWorklet pipeline, and an hls.js/MSE bridge for playing EC-3 where Chrome cannot decode it natively. The ./ac4 export decodes and encodes AC-4.",
  "type": "module",
  "license": "GPL-3.0-only",
  "keywords": [
    "ac3",
    "eac3",
    "ac4",
    "dolby-digital",
    "atmos",
    "audio",
    "codec",
    "wasm",
    "webassembly",
    "audioworklet",
    "hls.js"
  ],
  "homepage": "https://iainchesworthlabs.github.io/iclforge/platforms/wasm/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iainchesworthlabs/iclforge.git",
    "directory": "js"
  },
  "bugs": "https://github.com/iainchesworthlabs/iclforge/issues",
  "author": "iclforge contributors",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worklet-processor": {
      "types": "./dist/worklet-processor.d.ts",
      "default": "./dist/worklet-processor.js"
    },
    "./decoder-worker": {
      "types": "./dist/decoder-worker.d.ts",
      "default": "./dist/decoder-worker.js"
    },
    "./ac4": {
      "types": "./dist/ac4.d.ts",
      "default": "./dist/ac4.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
