<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Roadmap UX2's macOS leg: a custom Info.plist (CMake's own default one,
  MacOSXBundleInfo.plist.in, carries none of the document-type keys below,
  and CFBundleDocumentTypes/UTExportedTypeDeclarations can only be added by
  supplying a template of our own via MACOSX_BUNDLE_INFO_PLIST). Every
  ${VAR}-style token here is one of CMake's own documented MACOSX_BUNDLE_*
  variables, substituted the same way its default template substitutes
  them - see apps/gui/CMakeLists.txt's APPLE branch for where each is set.

  .ac3/.ec3 no longer appear here (Hearth phase A7,
  planning/hearth-reference-player.md): ac3hearth is the reference player
  and now owns both UTIs in apps/hearth/ui/Info.plist.in, the same
  CFBundleDocumentTypes/UTExportedTypeDeclarations shape this file used to
  carry. A UTI with two LSHandlerRank Owner claims is undefined which
  application Launch Services picks, so only one bundle may declare it.
  Everything else below is CMake's own default template's own fields,
  kept here rather than dropping this file, since ac3gui still needs a
  custom template for no other reason than historical inertia - removing
  it is a separate change, not part of this one.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleGetInfoString</key>
	<string>${MACOSX_BUNDLE_INFO_STRING}</string>
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>${MACOSX_BUNDLE_LONG_VERSION_STRING}</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>
</dict>
</plist>
