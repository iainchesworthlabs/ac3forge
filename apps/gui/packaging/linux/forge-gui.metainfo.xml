<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo (GUI AppStream packaging) - what puts forge-gui in a Linux desktop's
  own application menu/software centre, alongside forge-gui.desktop (the entry
  itself). <id> matches the .desktop file's own basename, the launchable
  AppStream itself requires to associate the two.

  No <provides><mediatype> for .ac3/.ec3 (Hearth phase A7,
  planning/hearth-reference-player.md): hearth is the reference player
  and claims both now, in its own metainfo.xml and .desktop's MimeType=.
  forge-gui still opens a stream handed to it on the command line - the file
  dialog and drag-and-drop inside the window are unaffected - it no longer
  advertises itself as a handler to the desktop shell for either format.
-->
<component type="desktop-application">
  <id>forge-gui.desktop</id>
  <name>forge-gui</name>
  <summary>Encode, decode, play and check AC-3, E-AC-3 and AC-4 streams</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      forge-gui is the Qt6 front end for ICL Forge, a clean-room implementation of the AC-3
      (Dolby Digital), E-AC-3 (Dolby Digital Plus) and AC-4 audio codecs. It encodes and
      decodes all three, including Dolby Atmos object audio and metadata (OAMD and JOC in
      E-AC-3, object content in AC-4), plays an already-encoded stream, and checks a stream's
      levels and loudness. Live capture encodes to AC-3 and E-AC-3.
    </p>
  </description>
  <launchable type="desktop-id">forge-gui.desktop</launchable>
  <url type="homepage">https://github.com/iainchesworthlabs/iclforge</url>
  <provides>
    <binary>forge-gui</binary>
  </provides>
  <content_rating type="oars-1.1"/>
</component>
