<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo (GUI AppStream packaging) - what puts ac3gui in a Linux desktop's
  own application menu/software centre, alongside ac3gui.desktop (the entry
  itself). <id> matches the .desktop file's own basename, the launchable
  AppStream itself requires to associate the two.

  No <provides><mediatype> for .ac3/.ec3 (Hearth phase A7,
  planning/hearth-reference-player.md): ac3hearth is the reference player
  and claims both now, in its own metainfo.xml and .desktop's MimeType=.
  ac3gui still opens a stream handed to it on the command line - the file
  dialog and drag-and-drop inside the window are unaffected - it no longer
  advertises itself as a handler to the desktop shell for either format.
-->
<component type="desktop-application">
  <id>ac3gui.desktop</id>
  <name>ac3gui</name>
  <summary>Forge — the AC3Forge encoder tools: clean-room AC-3 / E-AC-3 encoder, decoder and Dolby Atmos object-layer toolkit</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      ac3gui is the Qt6 front end for ac3forge, a clean-room implementation of the AC-3 and
      E-AC-3 (Dolby Digital / Dolby Digital Plus) audio codecs. It encodes and decodes both
      formats, including Dolby Atmos object-layer (OAMD/JOC) metadata and audio, and plays
      back an already-encoded stream directly.
    </p>
  </description>
  <launchable type="desktop-id">ac3gui.desktop</launchable>
  <url type="homepage">https://github.com/iainchesworthlabs/ac3forge</url>
  <provides>
    <binary>ac3gui</binary>
  </provides>
  <content_rating type="oars-1.1"/>
</component>
