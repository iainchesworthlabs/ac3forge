# The AC-4 decoder's probe on the ESP32-S3 (planning/ac4.md, D14c), over sdkconfig.defaults:
#
#   SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.ac4" idf.py build
#   tools/checks/run_esp32s3_probe.sh --ac4              # the same, under QEMU, and gated
#
# The component's AC-4 decoder, and the AC-4 probe (apps/baremetal/ac4_probe.cpp) in place
# of the AC-3 and E-AC-3 one: the six fixtures of apps/baremetal/ac4_fixture.hpp, each
# channel's level and the PCM hash the Cortex-M3 leg and the host pin.
CONFIG_ICLFORGE_AC4=y

# The decoder's state in PSRAM. It holds 0.4 to 0.6 MB at 2.0 and up to 1.8 MB at 5.1.4,
# where this part has 347 KB of internal RAM free, so it goes to the board's 8 MB of octal
# PSRAM. A request of 512 bytes or more tries PSRAM first and a smaller one internal RAM
# first, either falling back to the other: the placement examples/hearth_sink gives an
# AC-4 play on this part (its sdkconfig.psram, CONFIG_ICLFORGE_AC4_INTERNAL_BELOW), which
# the probe has no player to set and takes for the whole run. Under ESP-IDF's default of
# 16 KB the decoder's blocks of 8 to 16 KB took internal RAM to 1.3 KB free at 5.1.4, and
# 248 to 264 KB of it at 2.0; at 512 it keeps 3 to 14 KB there (planning/ac4.md, D14c).
# QEMU emulates the octal PSRAM (idf.py qemu passes is_octal for CONFIG_SPIRAM_MODE_OCT),
# so CI runs the shape a board runs.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# Not tested at boot: a second on 8 MB, and the probe's checks say whether it works.
CONFIG_SPIRAM_MEMTEST=n

# The main task runs the decode, with the probe's painted window under its frame
# (main/CMakeLists.txt's ICLFORGE_PROBE_STACK_WINDOW_BYTES). The stack is internal RAM.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
