<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app's only permission. VIBRATE is a normal permission, granted at
         install with no runtime prompt, and it is what lets the demo pulse the
         CONTROLLER (not the box) as an object crosses overhead - see
         Haptics.kt. Without it, InputDevice.getVibrator().vibrate() throws
         SecurityException rather than silently doing nothing. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android TV, not a phone/tablet fallback: a touchscreen is optional,
         leanback (the D-pad-navigable TV UI model) is required. Play would
         use this to keep the app off phones; irrelevant for a personal
         sideload (see docs/platforms/android.md) but correct either way. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- A Shield Controller is the best way to drive this demo (two analog
         sticks, shoulder buttons) but not a requirement: InputController
         handles the bundled remote's D-pad as a first-class path, which is
         why the D-pad-center axis-mode toggle exists at all. Declaring it
         required=false says so explicitly rather than leaving it to be
         inferred. -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.ShieldAtmosDemo">

        <!-- configChanges lists every configuration change this Activity can
             survive without being recreated. Recreation is not cosmetic here:
             onDestroy tears down the AudioTrack, which drops the AVR's lock on
             the bitstream and bounces the user back through the "Waiting for
             receiver..." interstitial. navigation and keyboard are the ones
             that actually fire on this device class - pairing or dropping a
             Bluetooth controller changes both - and uiMode fires on a
             day/night or TV-mode switch. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER, not just LAUNCHER: this is what puts
                     the app on the Android TV home screen row. Omitting it
                     leaves the app installed but nowhere a remote-only user
                     could ever find it. android:banner above is what actually
                     shows in that row - without one, Android falls back to a
                     poorly-scaled android:icon instead. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reached only from MainActivity's KEYCODE_INFO handler - not
             exported, no launcher intent-filter of its own. -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="About"
            android:screenOrientation="landscape" />

    </application>

</manifest>
