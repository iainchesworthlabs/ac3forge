<?xml version="1.0" encoding="utf-8"?>
<!--
  The WDK and SDK as NuGet packages, for a build with no WDK installed:
  `nuget restore .\packages.config -PackagesDirectory .\packages`, then
  msbuild from a Visual Studio developer shell that has the "Windows Driver
  Kit" component (the WindowsKernelModeDriver10.0 toolset) and the
  Spectre-mitigated libraries - which GitHub's windows-latest image does, so
  this is what CI builds the driver with (.github/workflows/_build.yml,
  windows-driver). Directory.Build.props imports the packages when they are
  present and is inert when they are not, so the EWDK build (README.md) is
  unaffected. The kit build number (28000) matches the EWDK's; keep the three
  entries on one version.
-->
<packages>
  <package id="Microsoft.Windows.SDK.CPP" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.CPP.x64" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.WDK.x64" version="10.0.28000.2526" targetFramework="native" />
</packages>
