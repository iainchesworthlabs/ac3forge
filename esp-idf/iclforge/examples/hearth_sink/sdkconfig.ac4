# AC-4 in the Hearth sink (planning/ac4.md, D14b): the component's AC-4 decoder
# on, so that a stream opening with an AC-4 sync word plays as an AC-3 or E-AC-3
# one does - from any source, over the HTTP source's POST /play as much as from a
# partition - and its play ends with the ac4.* lines that say what it cost.
#
#   idf.py -DIDF_TARGET=esp32p4 \
#     "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.hw;sdkconfig.p4;sdkconfig.sendspin;sdkconfig.ac4" \
#     -DICLFORGE_STAGE_TIMERS=ON build
#
# -DICLFORGE_STAGE_TIMERS=ON adds the play.stage[<zone>] lines, one for each part
# of the decode: the QMF bank, the inverse transform, A-SPX, A-CPL and the
# sample rate converter. Without it the decode is the same code with no markers.
#
# In practice for a part with PSRAM: a decoder needs more than internal RAM has
# (docs/platforms/bare-metal/esp32-p4.md, AC-4). A part with no FPU decodes in the
# fixed-point tier, and on an ESP32-C6 nothing fits beside WiFi
# (docs/platforms/bare-metal/esp32-c6.md, AC-4).
CONFIG_ICLFORGE_AC4=y

# The decode task's stack: the decoder used about 50 KB of it before D14a's third part
# (the parser held a stream's element tables as locals) and uses 20 to 24 KB now, so
# the example's default of 32 KB leaves under 10 KB in the widest mode and this takes
# 40 KB. stream.decode_stack_free says what a play left.
CONFIG_ICLFORGE_EXAMPLE_DECODE_STACK_BYTES=40960
