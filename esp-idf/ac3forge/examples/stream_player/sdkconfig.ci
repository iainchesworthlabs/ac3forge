# What CI overlays on sdkconfig.defaults, via
# SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.ci".
#
# qemu-system-xtensa has no I2S peripheral. With the output enabled the first
# i2s_channel_write blocks on a DMA that will never drain and the job times out;
# with it disabled everything this example is actually testing - reading the
# partition a block at a time, assembling access units across those block
# boundaries, decoding them - runs exactly as it does on hardware.
# The capture sink rather than the null one. Both stand in for a peripheral
# QEMU does not have; the difference is that this one runs the SAME conversion
# the real sinks run (esp-idf/ac3forge/include/ac3forge/interleave.hpp, not a
# copy) and then checks what came out - so CI gates on the samples rather than
# on the loop having turned over.
CONFIG_AC3FORGE_EXAMPLE_SINK_CAPTURE=y

# Two passes, so the rewind path at end of stream is exercised rather than only
# the first read, and then the application stops with a verdict.
CONFIG_AC3FORGE_EXAMPLE_MAX_LAPS=2
