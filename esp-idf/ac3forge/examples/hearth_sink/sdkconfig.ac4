# AC-4 in the Hearth sink (planning/ac4.md, D14b): the component's AC-4 decoder
# on, so that a stream opening with an AC-4 sync word plays as an AC-3 or E-AC-3
# one does - from any source, over the HTTP source's POST /play as much as from a
# partition - and its play ends with the ac4.* lines that say what it cost.
#
#   idf.py -DIDF_TARGET=esp32p4 \
#     "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.hw;sdkconfig.p4;sdkconfig.sendspin;sdkconfig.ac4" \
#     -DAC3FORGE_STAGE_TIMERS=ON build
#
# -DAC3FORGE_STAGE_TIMERS=ON adds the play.stage[<zone>] lines, one for each part
# of the decode: the QMF bank, the inverse transform, A-SPX, A-CPL and the
# sample rate converter. Without it the decode is the same code with no markers.
#
# Only for a part with a floating-point unit (the component's Kconfig says so),
# and in practice for one with PSRAM: a decoder needs more than internal RAM has
# (docs/platforms/bare-metal/esp32-p4.md, AC-4).
CONFIG_AC3FORGE_AC4=y

# The decode task's stack: today's decoder uses about 50 KB of it (the parser holds a
# stream's element tables as locals), and at the default 32 KB the first play of a
# stream ends in a stack overflow. stream.decode_stack_free says what a play left.
CONFIG_AC3FORGE_EXAMPLE_DECODE_STACK_BYTES=65536

# Allocations over 512 bytes go to PSRAM first. ESP-IDF's default of 16 KB sends
# everything up to that size to internal RAM while any is left, and the decoder's many
# blocks of that size use it all. On an ESP32-P4 the AC-4 decoder took 1.0 to 1.9 times
# less time a frame with this setting (2.0 in SIMPLE mode 36.8 ms to 31.6, 5.1 150.8 ms
# to 82.2), and the AC-3 and E-AC-3 decoders 1.2 to 1.7 times more, which leaves them
# well inside real time. A setting of none at all measured as 512 bytes does
# (docs/platforms/bare-metal/esp32-p4.md, AC-4).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
