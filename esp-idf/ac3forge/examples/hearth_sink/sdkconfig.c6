# Overlay for an ESP32-C6: one 160 MHz RISC-V core with no FPU and no PSRAM.
#
#   idf.py -DIDF_TARGET=esp32c6 "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.c6" build
#
# Nothing here chooses the fixed-point tier: esp-idf/ac3forge/CMakeLists.txt sets
# AC3FORGE_DECODE_SCALAR from the target's CONFIG_SOC_CPU_HAS_FPU when a project has not, and
# this part has none. `idf.py -DAC3FORGE_DECODE_SCALAR=float build` measures the float tier on
# the same part instead - a part with no FPU decodes two to three times slower in it. See
# docs/platforms/bare-metal/esp32-c6.md for what the part decodes in real
# time. With WiFi running, this includes AC-3 5.1 at 0.82x and E-AC-3 5.1
# at 0.96x, plus stereo and mono.
#
# One I2S controller: its TDM frame holds 128 bits, eight 16-bit slots or four
# 32-bit ones, and there is no second line (AC3FORGE_EXAMPLE_I2S_SECOND_LINE
# stays 0).
CONFIG_IDF_TARGET="esp32c6"

# The part's maximum. The defaults' 240 MHz is an ESP32-S3 setting.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# The C6's own table, for a module with 4 MB of flash, the least any C6 module has:
# partitions.csv's two 4 MiB application slots do not fit in 4 MB, and partitions_c6.csv's
# are 1.75 MiB each. The Sendspin player image (1.58 MB with sdkconfig.sendspin-c6 in
# September 2026) fills one to 86%. A C6 with 16 MB of flash takes partitions.csv instead,
# through sdkconfig.flash16mb after this file.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_c6.csv"

# Quad I/O to the flash. The part runs its code from flash through a small
# cache, and a Sendspin player's decode, WiFi and server tasks take turns in
# it. On 2026-09-17, playing AC-3 2.0 over WiFi, QIO left about 8% of the
# part idle where DIO left about 1%, a burst's decode took 20.7 ms where it
# took 22.4, and a decrypt the server task had not run for a while took
# 790 us where it took 960. A bootloader that cannot set a flash chip's
# quad-enable bit says so and stays in DIO.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# One core: the player's two tasks go wherever the scheduler puts them. This file comes
# after sdkconfig.sendspin, whose DECODE_CORE=1 names a core the part does not have. The
# Sendspin player on a board is, in this order:
#
#   "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.hw;sdkconfig.sendspin;sdkconfig.c6;sdkconfig.sendspin-c6"
#
# sdkconfig.hw puts the console, and Improv with it, on the USB-Serial-JTAG port;
# sdkconfig.sendspin-c6 sizes the player for a part with no PSRAM.
CONFIG_AC3FORGE_EXAMPLE_FETCH_CORE=-1
CONFIG_AC3FORGE_EXAMPLE_DECODE_CORE=-1
