#pragma once

/* Compile-time version macros for iclforge's C API (AP1). Generated from
 * version.h.in by src/capi/CMakeLists.txt - do not edit the generated copy.
 *
 * These are the SDK version a caller built against, known at preprocessor
 * time (#if ICLFORGE_C_VERSION >= ...) - not what iclforge_version() reports,
 * which is the library actually linked at runtime and may differ before
 * v1.0's ABI promise exists (see iclforge.h's own header comment). */

#define ICLFORGE_C_VERSION_MAJOR @ICLFORGE_C_VERSION_MAJOR@
#define ICLFORGE_C_VERSION_MINOR @ICLFORGE_C_VERSION_MINOR@
#define ICLFORGE_C_VERSION_PATCH @ICLFORGE_C_VERSION_PATCH@

/* The three fields above, comparable as a single integer:
 * `#if ICLFORGE_C_VERSION >= 1002003` instead of a three-part comparison. */
#define ICLFORGE_C_VERSION \
    (ICLFORGE_C_VERSION_MAJOR * 1000000 + ICLFORGE_C_VERSION_MINOR * 1000 + ICLFORGE_C_VERSION_PATCH)

/* Set when this build's C API carries a working iclforge_ac4_* surface (ICLFORGE_BUILD_AC4
 * was ON when this library configured, the default). iclforge.h declares that section
 * either way, and a library built without it answers every fallible call with
 * ICLFORGE_ERROR_UNSUPPORTED - #ifdef this where a program needs to know which library it
 * was built against. */
#cmakedefine ICLFORGE_HAS_AC4
