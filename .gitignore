# Build output
build/
vcpkg_installed/
packages/

# Generated docs site (mkdocs build / mkdocs serve); published via the docs
# workflow to the gh-pages branch, never committed to develop/main.
site/

# Machine-local CMake presets (carry local VCPKG_ROOT)
CMakeUserPresets.json

# IDE / tooling
.vs/
.cache/
*.user

# apps/wasm/tests' Playwright harness (roadmap VX18a). package-lock.json IS
# committed (npm ci's own integrity-hash pinning, this project's equivalent
# of requirements/*.txt's --require-hashes); only the installed tree and
# Playwright's own run output are not.
apps/wasm/tests/node_modules/
apps/wasm/tests/test-results/
apps/wasm/tests/playwright-report/

# Python tooling for golden-vector generation, and the python/ bindings package (build/ above
# already covers python/build/; __pycache__/ already covers every test/tool's bytecode cache)
__pycache__/
.pytest_cache/
.coverage
*.egg-info/
python/dist/
wheelhouse/
# The throwaway venv ci.yml's script-lint job installs the pinned linters into, and
# that docs/building.md's local recipe uses by the same name. Also excluded in
# ruff.toml, so a local `ruff check .` never walks into its site-packages.
.lintvenv/

# Downloaded standards documents (free from ATSC/ETSI; not redistributed here)
docs/spec/

# The signing key MUST NOT reach a public remote. The EMDF object signer itself
# (src/signing) is committed clean-room - only the key is secret, supplied at
# runtime. The desktop tools take it by path/env (never a file in the tree),
# but the Shield app signs on-device and so reads it from a bundled asset: that
# asset is written from a CI secret at build time and must never be committed.
apps/android/app/src/main/assets/signing.key

# The older RE-derived signer OVERLAY predates the committed src/signing and is
# still quarantined: it additionally embeds the key extracted from Dolby's
# binary (see its README on its own branch) and must never leave a local
# branch. Ignoring it here means it cannot be staged by accident; a CI "no
# quarantine on main" check backs this up.
src/quarantine/

# Grown fuzzing corpus and crash artifacts (fuzz/run.sh): reproducible from
# fuzz/seeds/ plus a mutation budget, and can grow large. What must survive a
# fix - the minimized input that proved a bug - lives in fuzz/regressions/
# instead, which IS tracked.
fuzz/corpus/
fuzz/artifacts/

# Failing cases kept by tools/ci/fuzz_encoder_space.py. Same reasoning as above,
# one step stronger: every one of these is regenerable from the single case
# seed the harness prints beside it (`--replay <seed>`), so the WAV and
# bitstream copies are a convenience for looking at, never the record.
fuzz-encoder-artifacts/
fuzz-eac3-encoder-artifacts/

# The conformance vector bundle (tools/generators/gen_conformance_vectors.py,
# docs/conformance-vectors.md). Several MB of encoder output, regenerated from
# the script per release and published as a release asset - the script is the
# record, never a checked-in copy of what it produced. The default --out path
# in the docs and in _build.yml's own step.
dist/
