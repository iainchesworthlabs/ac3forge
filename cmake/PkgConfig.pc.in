prefix=@ICLFORGE_PC_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @ICLFORGE_PC_NAME@
Description: @ICLFORGE_PC_DESCRIPTION@
Version: @PROJECT_VERSION@
Requires: @ICLFORGE_PC_REQUIRES@
Requires.private: @ICLFORGE_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -l@ICLFORGE_PC_LIBNAME@
Libs.private: @ICLFORGE_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
