@PACKAGE_INIT@

# Independent, dependency-free libraries in one package - see
# cmake/InstallLibrary.cmake for why they're separate EXPORT sets sharing
# this one Config file rather than a single combined export.
include("${CMAKE_CURRENT_LIST_DIR}/forgeTargets.cmake")

# ac3::signing is mandatory, like ac3::forge itself (no AC3FORGE_BUILD_<NAME> switch, so no
# if(EXISTS) guard needed the way the optional components below need one).
include("${CMAKE_CURRENT_LIST_DIR}/signingTargets.cmake")

# matroska::matroska, mp4::mp4 and mpegts::mpegts are all optional components
# (AC3FORGE_BUILD_MATROSKA/AC3FORGE_BUILD_MP4/AC3FORGE_BUILD_MPEGTS) - each Targets file only
# exists when that component was actually installed, e.g. a vcpkg install() built without a
# given feature (see cmake/InstallLibrary.cmake's header comment; each of the three maps onto
# its own vcpkg feature). Same shape applies to any future optional component's own
# *Targets.cmake.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/matroskaTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/matroskaTargets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/mp4Targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/mp4Targets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/mpegtsTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/mpegtsTargets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/iabTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/iabTargets.cmake")
endif()
# admTargets/admbridgeTargets.cmake, when present, each define ONLY a *_shared target (never
# *_static) - see cmake/InstallLibrary.cmake's AC3FORGE_BUILD_ADM block and
# src/ac3adm/CMakeLists.txt's header comment for why ac3adm/admbridge are shared-only, unlike
# every other component here.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/admTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/admTargets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/admbridgeTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/admbridgeTargets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/capiTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/capiTargets.cmake")
endif()

# A package built with the default AC3FORGE_INSTALL_BOTH_LINKAGES=ON (the direct-build/CPack
# SDK) has both ac3::forge_static and ac3::forge_shared and deliberately gets no bare ac3::forge
# here - there's no ambient BUILD_SHARED_LIBS to resolve against, so a consumer must pick one
# explicitly (see docs/library/index.md). A package built with that option OFF (a vcpkg install,
# which only ever installs one linkage per triplet - see cmake/InstallLibrary.cmake) has no such
# ambiguity: recreate the same bare-name convenience the in-tree build gets, for whichever one
# variant is actually present. Same treatment for matroska::matroska, mp4::mp4 and
# mpegts::mpegts - each guarded on its own TARGET check, since any of the three may be
# entirely absent (its *Targets.cmake never included above) rather than merely single-linkage.
if(TARGET ac3::forge_shared AND NOT TARGET ac3::forge_static)
    add_library(ac3::forge ALIAS ac3::forge_shared)
elseif(TARGET ac3::forge_static AND NOT TARGET ac3::forge_shared)
    add_library(ac3::forge ALIAS ac3::forge_static)
endif()
if(TARGET ac3::signing_shared AND NOT TARGET ac3::signing_static)
    add_library(ac3::signing ALIAS ac3::signing_shared)
elseif(TARGET ac3::signing_static AND NOT TARGET ac3::signing_shared)
    add_library(ac3::signing ALIAS ac3::signing_static)
endif()
if(TARGET matroska::matroska_shared AND NOT TARGET matroska::matroska_static)
    add_library(matroska::matroska ALIAS matroska::matroska_shared)
elseif(TARGET matroska::matroska_static AND NOT TARGET matroska::matroska_shared)
    add_library(matroska::matroska ALIAS matroska::matroska_static)
endif()
if(TARGET mp4::mp4_shared AND NOT TARGET mp4::mp4_static)
    add_library(mp4::mp4 ALIAS mp4::mp4_shared)
elseif(TARGET mp4::mp4_static AND NOT TARGET mp4::mp4_shared)
    add_library(mp4::mp4 ALIAS mp4::mp4_static)
endif()
if(TARGET mpegts::mpegts_shared AND NOT TARGET mpegts::mpegts_static)
    add_library(mpegts::mpegts ALIAS mpegts::mpegts_shared)
elseif(TARGET mpegts::mpegts_static AND NOT TARGET mpegts::mpegts_shared)
    add_library(mpegts::mpegts ALIAS mpegts::mpegts_static)
endif()
if(TARGET ac3iab::ac3iab_shared AND NOT TARGET ac3iab::ac3iab_static)
    add_library(ac3iab::ac3iab ALIAS ac3iab::ac3iab_shared)
elseif(TARGET ac3iab::ac3iab_static AND NOT TARGET ac3iab::ac3iab_shared)
    add_library(ac3iab::ac3iab ALIAS ac3iab::ac3iab_static)
endif()
if(TARGET ac3::forge_c_shared AND NOT TARGET ac3::forge_c_static)
    add_library(ac3::forge_c ALIAS ac3::forge_c_shared)
elseif(TARGET ac3::forge_c_static AND NOT TARGET ac3::forge_c_shared)
    add_library(ac3::forge_c ALIAS ac3::forge_c_static)
endif()

# Single-branch, unlike every alias above: ac3adm::ac3adm_static/ac3::admbridge_static are never
# installed here (shared-only export, see admTargets.cmake's own comment just above), so there is
# no elseif() case to handle - if the _shared target exists at all, the bare alias always means it.
if(TARGET ac3adm::ac3adm_shared)
    add_library(ac3adm::ac3adm ALIAS ac3adm::ac3adm_shared)
endif()
if(TARGET ac3::admbridge_shared)
    add_library(ac3::admbridge ALIAS ac3::admbridge_shared)
endif()

check_required_components(ac3forge)
