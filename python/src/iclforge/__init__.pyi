        no_container: int
        @property
        def all_valid(self) -> bool: ...

    @staticmethod
    def load_signing_key(path: str = ...) -> signing.SigningKey: ...
    @staticmethod
    def sign_atmos_stream(stream: bytes, key: signing.SigningKey) -> tuple[bytes, int]: ...
    @staticmethod
    def has_authenticity_tag(frame: bytes) -> bool: ...
    @staticmethod
    def verify_atmos_stream(stream: bytes, key: signing.SigningKey) -> signing.VerifySummary: ...

