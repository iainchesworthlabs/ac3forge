_FloatArray = npt.NDArray[np.float32]
# Every encode_frame/encode_access_unit `channels`/`objects` parameter: either a
# single 2-D (n_channels, n_samples) array, or a sequence of 1-D per-channel arrays - both
# zero-copy when already contiguous float32 (see python-api.md's "Zero-copy numpy" section).
_ChannelsIn = _FloatArray | Sequence[_FloatArray]

class Ac3Error(RuntimeError): ...

class Ac3EncodeError(Ac3Error):
    error: FrameError

class Ac3DecodeError(Ac3Error):
    error: DecodeError

class Ac3ScanError(Ac3Error):
    error: ScanError

# AC-4's own failures (plan phase I4b): a ValueError, which is what ac3.ac4 raised before they had
# types of their own, so `except ValueError` still catches every one. `error` is the C++
# enumerator (ac4.DecodeError, ac4.EncodeError).
class Ac4Error(ValueError): ...

class Ac4DecodeError(Ac4Error):
    error: ac4.DecodeError

class Ac4EncodeError(Ac4Error):
    error: ac4.EncodeError

