# Human-edited source for requirements-docs.txt. Regenerate the lock after any
# change here with:
#   python -m piptools compile --generate-hashes --strip-extras \
#     --output-file=requirements-docs.txt requirements-docs.in
#
# mkdocs is capped below 2.0 deliberately: 2.0 removes the plugin system, rewrites theming with
# no migration path, and is unlicensed as of this writing - see
# https://squidfunk.github.io/mkdocs-material/blog/2026/02/18/mkdocs-2.0/. That cap is not going
# to lift - 2.0 is a dead end for this site. Material for MkDocs itself is now in maintenance
# mode (critical/security fixes only, committed through roughly November 2026); its own
# maintainers' answer is Zensical (github.com/zensical/zensical), not MkDocs 2.0, which is why
# it's pinned below as a canary rather than the mkdocs>=1.6,<2.0 line being revisited.
mkdocs>=1.6,<2.0
mkdocs-material>=9.5,<10.0
# Non-blocking build canary (see .github/workflows/docs.yml) tracking Zensical as the eventual
# replacement for the line above once it proves itself on this site over real PRs. No version cap:
# it's pre-1.0 and the thing being evaluated, not a dependency to defend against.
zensical
