// The legs of the build matrix, one list per platform. tools/ci/plan_legs.py picks the
// legs a run needs and resolves their runner labels, _build.yml's `plan-legs` job hands
// each platform's list to _ci-linux.yml, _ci-windows.yml or _ci-macos.yml as
// `inputs.matrix`, and their steps read the fields below as `matrix.<field>`. The
// comments on the legs were written beside the matrices in those workflows, where
// "above", "below" and "the step below" mean the workflow's own steps.
//
// A comment is a `//` on a line of its own. The planner drops those lines, and what is
// left is plain JSON.
//
// Every leg has
//   name    the job's display name
//   tier    "t2" runs in the run on main after each merge; "deep" runs only in the
//           scheduled run and on request (docs/ci-agentic.md)
//   preset  the CMake preset suffix (config-/build-/test-<preset>)
// and one of
//   runner       runner labels as a JSON array, used as written
//   runner_slot  the name of a check-runners output (linux_runner_1, windows_runner_2,
//                ...) for a leg that runs on the self-hosted fleet when it has room and
//                falls back to a hosted runner when it does not
// Every other field is a flag or a value the workflow's steps test, and a flag a leg
// does not list is false.
//
// `ccache` and `parallel_tests` turn on build-leg's compiler cache and ctest's parallel
// phases for a leg (docs/ci-agentic.md). The plain legs set them. The two sanitizer
// legs do not: their test presets carry label filters that the parallel phases' own
// filters would replace, and what makes them slow is the sanitizers' cost at run time,
// which a compiler cache does not touch.
{
  "linux": [
    {
      "name": "Linux GCC",
      "tier": "t2",
      "runner_slot": "linux_runner_1",
      "container": "ubuntu:26.04",
      "preset": "linux-gcc",
      "ccache": true,
      "parallel_tests": true,
      // Hearth (planning/hearth-reference-player.md, A7): src/sendspin and apps/hearth,
      // with the [sendspin] and [hearth] cases ctest runs below. AC3FORGE_BUILD_HEARTH
      // defaults ON (root CMakeLists.txt) and CMakePresets.json's "core" fragment selects
      // vcpkg's "hearth" feature by default too, so every leg here builds and tests it
      // without a matrix field asking for it - hearth-validate (_ci-core.yml) is the only
      // place still naming it explicitly, for its own narrower A4 aiosendspin exit.
      "gcc": true,
      "gui": true,
      "packageable": true,
      "release_package": true,
      "alsa_fallback": true,
      "gold_reference": true,
      "conformance_vectors": true
    },
    {
      "name": "Linux LLVM (clang)",
      "tier": "t2",
      "runner_slot": "linux_runner_2",
      "container": "ubuntu:26.04",
      "preset": "linux-llvm",
      "ccache": true,
      "parallel_tests": true,
      "llvm": true,
      "gui": true,
      "packageable": true,
      "gold_reference": true,
      // AC3Forge Crucible's Linux half (Crucible cross-platform promotion). This leg and not
      // a GCC one because the GCC legs carry alsa_fallback, which
      // asserts that disabling ALSA falls back to posix - true only
      // while no PipeWire headers are installed, and the Crucible pass
      // below installs them. Keeping the two apart leaves that
      // assertion meaning what it says.
      "crucible": true
    },
    {
      // arm64 - Raspberry Pi 4/5 and any other aarch64 Debian/Ubuntu
      // target (see docs/platforms/raspberry-pi.md). Real ARM hardware via
      // GitHub's hosted ubuntu-24.04-arm runner label, not QEMU emulation -
      // the same ubuntu:26.04 container image as the x64 legs, which pulls
      // its arm64 variant automatically on an arm64 runner. Otherwise the
      // same shape as linux-gcc/linux-llvm above, including which leg
      // carries alsa_fallback (compiler and architecture both don't affect
      // that switch - see linux-gcc's own comment).
      "name": "Linux GCC (arm64)",
      "tier": "t2",
      "runner": ["ubuntu-24.04-arm"],
      "container": "ubuntu:26.04",
      "preset": "linux-gcc-arm64",
      "ccache": true,
      "parallel_tests": true,
      "gcc": true,
      "gui": true,
      "packageable": true,
      "release_package": true,
      "alsa_fallback": true,
      "gold_reference": true
    },
    {
      "name": "Linux LLVM (arm64)",
      "tier": "t2",
      "runner": ["ubuntu-24.04-arm"],
      "container": "ubuntu:26.04",
      "preset": "linux-llvm-arm64",
      "ccache": true,
      "parallel_tests": true,
      "llvm": true,
      "gui": true,
      "packageable": true,
      "gold_reference": true,
      // AC3Forge Crucible's Linux half on aarch64 (Crucible cross-platform promotion). The
      // Crucible pass further down is written against matrix.preset, so
      // this leg only has to ask for it: same apt list, same configure
      // assertions, same tests, same package as linux-llvm, and no
      // second copy of any of them to drift out of step.
      //
      // aarch64 is the only hardware the Linux half is on record as
      // having run on: it was written and verified against a receiver
      // on a Raspberry Pi 4B on 2026-09-05, in Phase 4 of
      // docs/crucible/design/promotion.md - a run that built the window,
      // passed all five Qt Quick suites and produced the aarch64
      // tarball and the arm64 .deb by hand. CI meanwhile built
      // Crucible on x86_64 alone, so the architecture the whole
      // record rests on was the one nothing checked, and an
      // aarch64-only compilation fault would have reached a user
      // through the .deb before anyone saw it.
      //
      // This leg and not "Linux GCC (arm64)" for two reasons. The first
      // is the one that put the pass on linux-llvm rather than
      // linux-gcc: that leg carries alsa_fallback, whose assertion that
      // disabling ALSA falls back to posix holds only while no PipeWire
      // headers are installed, and the pass installs them. The second
      // is release_package, which the GCC arm64 leg also carries: the
      // "Assert the AC3Forge Crucible was packaged (Windows)" step keys
      // off matrix.crucible && matrix.release_package with no runner.os
      // guard of its own, so on a do_package run it would go looking on
      // Linux for a packages/ac3forge-crucible-*.zip that no Linux leg
      // ever produces.
      "crucible": true
    },
    {
      // AddressSanitizer + UndefinedBehaviorSanitizer (cmake/Sanitizers.cmake),
      // -fno-sanitize-recover=all so a violation fails the job outright. Shares
      // the Linux LLVM container/toolchain; `sanitizer: true` additionally runs
      // the codec-matrix step below, since ctest's 200+ cases alone do not
      // reach every layout/tool/atmos code path a sanitizer needs to see
      // execute to be worth anything.
      //
      // Not `packageable`: there is no pack-linux-llvm-asan-ubsan preset
      // and there should not be one - a sanitizer-instrumented debug build
      // is a diagnostic tool, not something to ship.
      "name": "Linux LLVM ASan+UBSan",
      "tier": "t2",
      "runner_slot": "linux_runner_3",
      "container": "ubuntu:26.04",
      "preset": "linux-llvm-asan-ubsan",
      "llvm": true,
      "sanitizer": true,
      // 150, not the 90 every other leg gets. On 2026-09-21 this leg
      // took about 36 minutes. The AC-4 encoder and decoder tests merged
      // from 2026-09-25 on ran for minutes each under ASan+UBSan: main's
      // run at f5aded47 spent 72 of its minutes in ctest before the codec
      // matrix ran out of time at 90, and on #1057 ctest took 7,204 s,
      // 5,964 of them in the AC-4 tests, before the leg ran out of 150.
      // Under the sanitizers those tests now take fewer frames, shorter
      // signals and fewer cases (tests/sanitized.hpp), which cut their
      // serial time by 71 % in WSL; the 150 stays for the phases still to
      // come.
      "timeout_minutes": 150
    },
    {
      // ThreadSanitizer (ThreadSanitizer leg). A DIFFERENT question from the
      // ASan+UBSan leg above, not a duplicate of it: ASan/UBSan ask
      // whether one thread's memory and arithmetic are sound, TSan asks
      // whether two threads agree on who owns what - and no other gate in
      // this repository can see a data race at all. src/audio is a
      // lock-free SPSC ring, a silence watchdog and a clock-drift servo
      // shared between a real-time callback thread and the encoder
      // thread, which is exactly the shape where a missing
      // acquire/release is both easy to write and invisible until it
      // corrupts audio on someone else's machine.
      //
      // Its test preset runs `-L concurrency` rather than the whole
      // suite (CMakePresets.json's test-linux-llvm-tsan filter): TSan's
      // shadow memory makes every test several times slower, and the
      // other ~600 cases are single-threaded codec maths where it has
      // nothing to report. That keeps this leg to about the cost of a
      // build rather than a second full matrix entry - the ctest run
      // itself was 7 seconds over 36 tests when this landed.
      //
      // No `sanitizer: true`: that flag means the codec-matrix step, and
      // driving every layout/tool combination through ac3cli is an
      // ASan/UBSan errand. Not `gold_reference` or `packageable` either,
      // same reasoning as the ASan+UBSan leg's own comment above.
      // Self-hosted-capable again (reverted to ubuntu-latest in #460).
      // The failure was Docker's default seccomp profile rejecting the
      // personality(ADDR_NO_RANDOMIZE) call TSan uses to disable ASLR
      // from inside a container. The fleet image now sets
      // kernel.randomize_va_space=0 on the VM (ci-runners#13, deployed
      // 2026-08-28) - the sysctl is not namespaced, the container
      // inherits it, and TSan never needs the blocked syscall. If this
      // leg ever fails that way again, the fleet image regressed; the
      // per-job fallback is container options --security-opt
      // seccomp=unconfined, which is a much blunter instrument.
      "name": "Linux LLVM TSan",
      "tier": "t2",
      "runner_slot": "linux_runner_4",
      "container": "ubuntu:26.04",
      "preset": "linux-llvm-tsan",
      "llvm": true
    }
  ],
  "windows": [
    {
      "name": "Windows MSVC",
      "tier": "t2",
      "runner_slot": "windows_runner_1",
      "preset": "windows-msvc",
      "ccache": true,
      "parallel_tests": true,
      // Declared once, here, so `matrix.experimental` in continue-on-error
      // above resolves against a property the matrix actually defines -
      // without it every leg silently reads null and actionlint reports the
      // reference as undefined. Every other leg is non-experimental by
      // omission (the `|| false` fallback); a leg that IS experimental sets
      // this to true and continue-on-error keeps it out of CI Status.
      "experimental": false,
      // VS 2026 Build Tools / MSVC 14.5x, from the aka.ms/vs/18/stable
      // channel. Pinned by channel, not exact version: the runner image
      // ships whatever 18.x is current, and the assert step below fails
      // loudly if that ever stops being a 14.5x toolset.
      "msvc": true,
      "packageable": true,
      "release_package": true,
      "gold_reference": true,
      // AC3Forge Crucible (WASAPI loopback tap/UX12, apps/crucible): built and
      // tested on both Windows legs, packaged on this one (the Package
      // step's own condition already singles out windows-msvc), as its
      // own archive - see cmake/Packaging.cmake's crucible component. The
      // null-sink driver is NOT built on this leg: it needs the WDK,
      // which the self-hosted fleet lacks, so it has its own
      // GitHub-hosted job (windows-driver, below) that builds it from
      // the WDK NuGet packages. Still test-signed only, so it stays out
      // of the package until the EV certificate lands (Phase 6).
      "crucible": true
    },
    {
      "name": "Windows LLVM (clang-cl)",
      "tier": "t2",
      "runner_slot": "windows_runner_2",
      "preset": "windows-llvm",
      // Tests only. clang-cl's use of ccache is not proven here yet, and the compiler
      // cache never changes a result, so it can be added once a run shows it hitting.
      "parallel_tests": true,
      // clang-cl targets the MSVC ABI: same headers, same libs
      "msvc": true,
      "llvm": true,
      "packageable": true,
      "gold_reference": true,
      // Built and tested here too - clang-cl is stricter than MSVC about
      // several things the demo's Qt and WASAPI code touches - but not
      // packaged: this leg carries no release_package (see the Package
      // step's condition).
      "crucible": true
    },
    {
      // ARM64 - GitHub's hosted windows-11-vs2026-arm runner (Windows ARM64 / reach builds). Real
      // ARM64 hardware, not emulation. Deliberately NOT routed through
      // check-runners' self-hosted/hosted fan-out (the windows_runner_1/2
      // outputs the two legs above use) - that logic is sized for exactly
      // those two existing x64 Windows legs, and there is no self-hosted
      // ARM64 Windows capacity to fan out to; the literal runner label is
      // used directly instead.
      //
      // experimental: true, the same promotion path macos-llvm and
      // build-android both went through (see this file's own header) -
      // this leg's first real runs are exactly what confirms or corrects
      // the toolchain/vcvarsall/Qt/ffmpeg choices made without hosted-
      // runner access at authoring time. Delete this line once a run has
      // gone green for real.
      //
      // msvc_arch: arm64 threads through to the "Setup MSVC environment"
      // step, which otherwise always loads the x64 developer environment
      // (see .github/actions/setup-msvc-env/action.yml) - every other
      // matrix.msvc leg omits it and gets the action's own x64 default.
      //
      // No gui: true, unlike every other packageable leg. At authoring
      // time, Qt's only Windows ARM64 kit for the pinned 6.9.3
      // (win64_msvc2022_arm64_cross_compiled) is a cross-compile kit that
      // expects a paired win64_msvc2022_64 install for its host tools, and
      // aqtinstall has a documented CI bug against exactly that
      // combination (qtpaths.bat pointing at the wrong x64 setup) - real
      // complexity this leg's native-ARM64-host build doesn't need to
      // take on for a first pass. CMakePresets.json's windows-msvc-arm64
      // preset defaults AC3FORGE_BUILD_GUI off for exactly this reason
      // (see its own description) - the same "Qt kit not assumed present"
      // shape linux-gcc/linux-llvm/macos-llvm already use below, not a new
      // pattern. See docs/platforms/windows.md's ARM64 section.
      //
      // gold_reference: true - choco's ffmpeg package is x64-only, so this
      // leg installs BtbN's static win-arm64 ffmpeg build instead (see the
      // dedicated install step below).
      //
      // release_package: true, not just packageable: a genuinely new
      // architecture earns its own canonical release artifact, the same
      // precedent linux-gcc-arm64 already set sitting next to linux-gcc -
      // not a redundant same-arch compiler variant like windows-llvm
      // above (which stays non-canonical: no release_package there).
      "name": "Windows MSVC (arm64)",
      "tier": "t2",
      "runner": ["windows-11-vs2026-arm"],
      "preset": "windows-msvc-arm64",
      "ccache": true,
      "parallel_tests": true,
      "experimental": true,
      "msvc": true,
      "msvc_arch": "arm64",
      "packageable": true,
      "release_package": true,
      "gold_reference": true
    }
  ],
  "macos": [
    {
      "name": "macOS LLVM (Homebrew)",
      "tier": "t2",
      "runner": ["macos-latest"],
      "preset": "macos-llvm",
      // Both macOS legs set both: hosted macOS is the scarcest capacity this org has, so
      // a leg that finishes sooner matters here more than anywhere.
      "ccache": true,
      "parallel_tests": true,
      // Crucible compiles here and cannot be run here; see the Configure
      // step's note.
      "crucible": true,
      "mac_arch": "arm64",
      "llvm": true,
      "gui": true,
      "packageable": true,
      "gold_reference": true,
      // Declared once, here, so `matrix.release_package` in the shared
      // Package/asserts steps below resolves against a property this
      // file's matrix actually defines - the same reason windows-msvc
      // declares `experimental: false` in _ci-windows.yml. No macOS
      // leg carries a release_package build any more (DR8) - see
      // this matrix entry's own header comment further down.
      "release_package": false
    },
    {
      // x86_64 half of DR8's macOS universal binaries. macos-15-intel is
      // real native Intel hardware (confirmed against
      // docs.github.com/en/actions/reference/runners/github-hosted-runners
      // directly, not assumed), free for public repos - so this is a real
      // build, not a cross-compile or Rosetta emulation. Same toolchain
      // file, same install steps, same reasoning as the arm64 leg above
      // throughout this job; only the preset/triplet (x64-macos-llvm) and
      // runner label differ.
      //
      // No longer experimental: three consecutive real, hosted-runner runs
      // went green on this brand-new macos-15-intel label before this line
      // came off - the v0.0.0-alpha.1 and v0.0.0-alpha.2 release dry runs
      // and this feature branch's own required PR CI - each with a real
      // gold-reference pass (67.80/67.82/67.76 dB, matching the x86
      // baseline every other non-arm64 leg reports), not just "it
      // compiled." Same promotion process macos-llvm and build-android
      // went through before it - see this file's own header.
      "name": "macOS LLVM x64 (Homebrew, Intel)",
      "tier": "t2",
      "runner": ["macos-15-intel"],
      "preset": "macos-llvm-x64",
      "ccache": true,
      "parallel_tests": true,
      "crucible": true,
      "mac_arch": "x64",
      "llvm": true,
      "gui": true,
      "packageable": true,
      "gold_reference": true
    }
  ]
}
